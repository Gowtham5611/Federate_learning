{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://federate-learning.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://federate-learning.onrender.com/health"
    },
    {
      "source": "/ready",
      "destination": "https://federate-learning.onrender.com/ready"
    },
    {
      "source": "/models",
      "destination": "https://federate-learning.onrender.com/models"
    },
    {
      "source": "/metadata/:path*",
      "destination": "https://federate-learning.onrender.com/metadata/:path*"
    },
    {
      "source": "/predict/:path*",
      "destination": "https://federate-learning.onrender.com/predict/:path*"
    },
    {
      "source": "/csv/:path*",
      "destination": "https://federate-learning.onrender.com/csv/:path*"
    },
    {
      "source": "/evaluate/:path*",
      "destination": "https://federate-learning.onrender.com/evaluate/:path*"
    },
    {
      "source": "/research/:path*",
      "destination": "https://federate-learning.onrender.com/research/:path*"
    },
    {
      "source": "/ensemble/:path*",
      "destination": "https://federate-learning.onrender.com/ensemble/:path*"
    },
    {
      "source": "/train/:path*",
      "destination": "https://federate-learning.onrender.com/train/:path*"
    },
    {
      "source": "/predictions/:path*",
      "destination": "https://federate-learning.onrender.com/predictions/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
