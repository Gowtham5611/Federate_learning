# =============================================================================
# FedSecureAI — Production Hardened Inference Containerfile
# =============================================================================
# Stage 1: Build & Dependency Wheel Cache
# Stage 2: Minimal, Unprivileged Runtime Container
# =============================================================================

# --- Stage 1: Build Dependencies ---
FROM python:3.11-slim-bookworm AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/inference.txt /build/requirements.txt

# Pre-compile wheels for inference dependencies (CPU-only PyTorch build)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    -r requirements.txt

# --- Stage 2: Hardened Runtime Container ---
FROM python:3.11-slim-bookworm AS runtime

LABEL org.opencontainers.image.title="FedSecureAI Inference Service" \
      org.opencontainers.image.description="Privacy-Preserving Federated AML Inference Engine" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.licenses="Proprietary"

# Set strict Python runtime flags
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app/backend" \
    PORT=8000 \
    HOST=0.0.0.0 \
    APP_ENV=production \
    FEDSECUREAI_CHECKPOINT_DIR="/app/checkpoints" \
    FEDSECUREAI_DATA_DIR="/app/data"

# Create unprivileged system group and user
RUN groupadd -g 10001 fedsecure && \
    useradd -u 10001 -g fedsecure -s /bin/false -M fedsecure

WORKDIR /app

# Copy installed python site-packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy backend application source code
COPY --chown=fedsecure:fedsecure backend /app/backend

# Copy lightweight metadata schemas (excluding large raw/processed transaction CSVs)
COPY --chown=fedsecure:fedsecure data/processed/ibm_aml/HI-Small/metadata /app/data/processed/ibm_aml/HI-Small/metadata
COPY --chown=fedsecure:fedsecure data/processed/ibm_aml/LI-Medium/metadata /app/data/processed/ibm_aml/LI-Medium/metadata

# Create mount points for external volume checkpoints with secure permissions
RUN mkdir -p /app/checkpoints /tmp && \
    chown -R fedsecure:fedsecure /app && \
    chmod 755 /app/checkpoints && \
    chmod 1777 /tmp

# Switch to non-root user
USER 10001:10001

# Expose internal service port (bound to private network / gateway only)
EXPOSE 8000

# Container healthcheck using standard library urllib against /health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3).getcode() == 200 else 1)" || exit 1

# Execute Uvicorn ASGI server with single worker (PyTorch CPU bounded)
ENTRYPOINT ["uvicorn", "interfaces.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]

