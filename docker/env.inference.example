# =============================================================================
# FedSecureAI — Inference Container Runtime Configuration Template
# =============================================================================

# Application environment: production | staging | development
APP_ENV=production

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directory containing authenticated model checkpoints
FEDSECUREAI_CHECKPOINT_DIR=/app/checkpoints

# Explicit individual model overrides (optional; defaults to FEDSECUREAI_CHECKPOINT_DIR)
# FEDSECUREAI_HI_SMALL_CHECKPOINT=/app/checkpoints/hi_small_lstm_fedavg_iid_seed42_global_best.pt
# FEDSECUREAI_LI_MEDIUM_CHECKPOINT=/app/checkpoints/global_best.pt

# Directory containing feature metadata schema
FEDSECUREAI_DATA_DIR=/app/data

# Thread concurrency for CPU PyTorch inference
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2

