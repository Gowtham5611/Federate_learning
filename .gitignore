# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# =============================================================================
# Virtual environments
# =============================================================================
.venv/
.venv-*/
venv/
env/

# =============================================================================
# Environment / secrets
# =============================================================================
.env
.env.*
!.env.example
kaggle.json
*.pem
*.key

# =============================================================================
# Datasets and generated data (never committed)
# =============================================================================
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/partitions/*
!data/partitions/.gitkeep
data/cache/*
!data/cache/.gitkeep
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/interim/*
!backend/data/interim/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep
backend/data/results_store/*
!backend/data/results_store/.gitkeep
!backend/data/processed/ibm_aml/
!backend/data/processed/ibm_aml/*/metadata/
!backend/data/processed/ibm_aml/*/metadata/**
backend/data/partitions/*
!backend/data/partitions/.gitkeep
backend/data/cache/*
!backend/data/cache/.gitkeep

# =============================================================================
# Model artefacts
# =============================================================================
models/checkpoints/*
!models/checkpoints/.gitkeep
!models/checkpoints/**/best.pt
models/artifacts/*
!models/artifacts/.gitkeep
backend/models/checkpoints/*
!backend/models/checkpoints/.gitkeep
!backend/models/checkpoints/*/
!backend/models/checkpoints/**/best.pt
backend/models/artifacts/*
!backend/models/artifacts/.gitkeep
backend/results/uploads/*
!backend/results/uploads/.gitkeep
scratch/
archive/zips/
archive/audits/

# =============================================================================
# Experiment runs and evaluation output
# (experiments/configs IS tracked - it declares experiments, not results)
# =============================================================================
experiments/runs/*
!experiments/runs/.gitkeep
experiments/results/*
!experiments/results/.gitkeep
evaluation/metrics/*
!evaluation/metrics/.gitkeep
!evaluation/metrics/*.py
!evaluation/metrics/__init__.py
evaluation/reports/*
!evaluation/reports/.gitkeep
evaluation/visualizations/*
!evaluation/visualizations/.gitkeep

# =============================================================================
# Logs and reports
# =============================================================================
logs/*
!logs/.gitkeep
reports/*
!reports/.gitkeep

# =============================================================================
# Data file formats (anywhere in the tree)
# =============================================================================
*.csv
*.tsv
*.parquet
*.feather
*.zip
*.npz
*.npy
*.mmap
*.mmap_*
backend/results/diagnostics/*
!backend/results/diagnostics/.gitkeep
backend/results/LI_Medium_Results/archives/
backend/experiments/archive/
backend/experiments/results/
artifacts/
archive/
scratch/
*.tar
*.tar.gz
*.gz
*.7z
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.ckpt
*.onnx
*.db
*.sqlite
*.sqlite3

# Small curated test inputs are the one exception - review before adding.
!backend/tests/fixtures/**/*.csv

# Live inference runtime metadata and champion model weights
!backend/data/processed/ibm_aml/*/metadata/**
!data/processed/ibm_aml/*/metadata/**
!backend/results/HI_Small_Results/checkpoints/*/*_global_best.pt
!backend/results/LI_Medium_Results/checkpoints/*/*global_best.pt
!backend/models/checkpoints/*/*best.pt
!backend/models/baselines/lightgbm_baseline.txt

# Phase 7 & 8 research benchmarks, ensemble validation, and demo data
!backend/results/phase8/**/*.csv
!backend/results/phase7/**/*.csv
!backend/results/phase7/**/*.json
!backend/results/phase7/**/*.npz
!backend/data/demo/**/*.csv
!backend/data/demo_samples/**/*.csv
!backend/data/demo_slices/**/*.csv

# =============================================================================
# Node / Frontend
# =============================================================================
node_modules/
frontend/node_modules/
frontend/dist/
.npm/

