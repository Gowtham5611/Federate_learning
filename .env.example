# =============================================================================
# FedSecureAI - example environment file
# =============================================================================
# Copy to `.env` and fill in real values. `.env` is git-ignored. It stays at the
# repository root: it is read by the backend but is not owned by it.
# Only variables the current code can act on are listed. Later phases append
# their own (see backend/config/README.md).
# =============================================================================

# --- Application ------------------------------------------------------------
# development | testing | production
APP_ENV=development
LOG_LEVEL=INFO

# --- Reproducibility --------------------------------------------------------
RANDOM_SEED=42

# --- Kaggle credentials -----------------------------------------------------
# Required only to DOWNLOAD the dataset. Everything else - dataset-info, the
# whole unit test suite - works with these blank.
#
# Obtain them from https://www.kaggle.com/settings -> API -> Create New Token.
# The downloaded kaggle.json contains both values.
#
# These are read ONLY by
# backend/infrastructure/data/downloaders/credentials.py, and only at the moment
# a download is explicitly requested. The API key is registered with the log
# redaction filter as soon as it is read, so it cannot reach a log file.
#
# Never commit real values. `.env` and `kaggle.json` are both git-ignored.
KAGGLE_USERNAME=
KAGGLE_KEY=
